# Copy this file to .env.local before running locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Create a project at WalletConnect Cloud and set its Project ID here.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Required for persistent transaction history (Supabase Project Settings > API).
# Keep the service role key server-side only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
